# name: test/sql/sqlearn_version.test
# description: sqlearn_version() names the build, and the sqlearn extension turns automatic installs off
# group: [sqlearn]

require sqlearn

# core::describe's line: sqlearn's version, then DuckDB's from the pins
query I
SELECT sqlearn_version() LIKE 'sqlearn %, DuckDB 2.0.1 (8d78114e90)%';
----
true

statement error
SELECT sqlearn_version(1);
----
Binder Error: No function matches the given name and argument types 'sqlearn_version(INTEGER_LITERAL)'

# No download by default (ADR 0006, 0061): the extension sets it at load
query I
SELECT current_setting('autoinstall_known_extensions');
----
false
