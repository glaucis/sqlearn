# DuckDB's Python packages, installed into sqlearn's wheel beside sqlearn/.
#
# Their files are copied as they are, but for two that duckdb-python's own
# build backend would write and ours does not run: duckdb/_version.py reads
# the version of a distribution named duckdb, which sqlearn's wheel is not,
# so its one such line becomes the pinned version; and duckdb/_build_info.py
# is generated from the pins. Their _duckdb module installs itself, by their
# own rule, at SKBUILD_PLATLIB_DIR.

set(SQ_DUCKDB_VERSION_LINE [=[__version__: str = _dist_version("duckdb")]=])

# Write `source` to `dest` with its one line SQ_DUCKDB_VERSION_LINE replaced
# by the literal `version`. Fails unless the line occurs exactly once, so an
# upstream change to the file is reviewed, never silently built.
function(sq_duckdb_version_file source dest version)
  file(READ "${source}" text)
  string(LENGTH "${text}" full)
  string(REPLACE "${SQ_DUCKDB_VERSION_LINE}" "" without "${text}")
  string(LENGTH "${without}" short)
  string(LENGTH "${SQ_DUCKDB_VERSION_LINE}" line)
  math(EXPR count "(${full} - ${short}) / ${line}")
  if(NOT count EQUAL 1)
    message(FATAL_ERROR
            "duckdb/_version.py changed upstream: review the substitution in "
            "engine/cmake/duckdb_package.cmake (the line\n"
            "  ${SQ_DUCKDB_VERSION_LINE}\n"
            "occurs ${count} times in ${source}, not once)")
  endif()
  string(REPLACE "${SQ_DUCKDB_VERSION_LINE}"
                 "__version__: str = \"${version}\"" text "${text}")
  file(WRITE "${dest}" "${text}")
endfunction()

# Write duckdb/_build_info.py to `dest`, from the pins: the module
# duckdb-python's backend writes (PACKAGE_COMMIT, which build_info() reads),
# with the other fields of its BuildInfo beside it.
function(sq_duckdb_build_info_file dest package_version)
  file(WRITE "${dest}"
       "\"\"\"Generated by sqlearn's build from engine/cmake/pins.cmake. Do not edit.\"\"\"\n"
       "\n"
       "PACKAGE_VERSION = \"${package_version}\"\n"
       "PACKAGE_COMMIT = \"${SQ_DUCKDB_PYTHON_COMMIT}\"\n"
       "DUCKDB_VERSION = \"${SQ_DUCKDB_TAG}\"\n"
       "DUCKDB_COMMIT = \"${SQ_DUCKDB_COMMIT}\"\n")
endfunction()

# Generate the two files at configure time and install duckdb/,
# adbc_driver_duckdb/ and _duckdb-stubs/ from `root`, duckdb-python's tree.
function(sq_install_duckdb_package root)
  string(REGEX REPLACE "^v" "" version "${SQ_DUCKDB_TAG}")
  set(generated "${CMAKE_CURRENT_BINARY_DIR}/duckdb-package")
  sq_duckdb_version_file("${root}/duckdb/_version.py"
                         "${generated}/_version.py" "${version}")
  sq_duckdb_build_info_file("${generated}/_build_info.py" "${version}")
  # A change to their _version.py configures again, and so is checked.
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
                                         "${root}/duckdb/_version.py")

  set(platlib "${SKBUILD_PLATLIB_DIR}")
  install(DIRECTORY "${root}/duckdb/" DESTINATION "${platlib}/duckdb"
          PATTERN "__pycache__" EXCLUDE
          PATTERN "*.pyc" EXCLUDE
          PATTERN "_version.py" EXCLUDE
          PATTERN "_build_info.py" EXCLUDE)
  install(FILES "${generated}/_version.py" "${generated}/_build_info.py"
          DESTINATION "${platlib}/duckdb")
  foreach(package IN ITEMS adbc_driver_duckdb _duckdb-stubs)
    install(DIRECTORY "${root}/${package}/" DESTINATION "${platlib}/${package}"
            PATTERN "__pycache__" EXCLUDE
            PATTERN "*.pyc" EXCLUDE)
  endforeach()
endfunction()
