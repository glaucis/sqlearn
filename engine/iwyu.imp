# include-what-you-use's mappings for the libraries sqlearn's C++ includes
# (`just iwyu-engine`, validation/_tidy.py): which header of each is the one
# to include for a symbol declared in another of its headers.
[
  # RapidCheck: <rapidcheck.h> is the library, its headers under
  # rapidcheck/ its parts; <rapidcheck/catch.h>, the Catch2 integration, is
  # included as itself.
  { include: ["@<rapidcheck/[A-Z].*>", "private", "<rapidcheck.h>", "public"] },
  { include: ["@<rapidcheck/(detail|fn|gen|seq|shrink|shrinkable)/.*>", "private", "<rapidcheck.h>", "public"] },
  # nanobind: <nanobind/nanobind.h> is the library; its type casters
  # (nanobind/stl/*.h) are included as themselves.
  { include: ["@<nanobind/nb_.*>", "private", "<nanobind/nanobind.h>", "public"] },
  # Python's C API, whose one header to include is <Python.h>, is mapped by
  # the python3.8.imp include-what-you-use ships (validation/_tidy.py).
]
