#!/usr/bin/env bash
# Refuse a commit message that breaks the rules in commitlint.config.mjs.
# The message is cleaned of git's comment lines, then handed to commitlint.
set -u

msgfile=${1:-}
if [ -z "$msgfile" ] || [ ! -f "$msgfile" ]; then
  echo "commit-msg: git gave no message file, so nothing was checked." >&2
  exit 1
fi

work=$(mktemp -d) || exit 1
trap 'rm -rf "$work"' EXIT

# 1. A replayed message was accepted when it was written; git's own revert
#    subject is not `type: subject`, and a refusal would strand the operation.
#    The git directory is asked of git, since a linked worktree's .git is a file.
gitdir=$(git rev-parse --absolute-git-dir 2>/dev/null) || gitdir=$(git rev-parse --git-dir) || exit 1
for marker in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD rebase-apply; do
  if [ -e "$gitdir/$marker" ]; then
    exit 0
  fi
done
#    In an interactive rebase the last line of rebase-merge/done is the step
#    being run. A `reword`, or a commit made at an `edit` stop, is a message
#    written now, so it is checked; any other step replays an old one.
if [ -e "$gitdir/rebase-merge" ]; then
  step=""
  if [ -f "$gitdir/rebase-merge/done" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      step=$line
    done <"$gitdir/rebase-merge/done"
  fi
  case "${step%% *}" in
    reword | r | edit | e) ;;
    *) exit 0 ;;
  esac
fi

# 2. Clean the message: the diff below a scissors line (git commit -v), then
#    comment lines. The comment character is core.commentChar ("auto" is `#`).
cc=$(git config --get core.commentChar 2>/dev/null || true)
case "$cc" in
  "" | auto) cc="#" ;;
esac
cc=${cc:0:1}
# A subject that starts with the comment character would be kept by `-m` but
# deleted here, so the hook would check a different message from git's.
IFS= read -r first <"$msgfile" || true
case "$first" in
  "$cc"*)
    {
      echo "commit-msg: refused: a commit subject may not start with '$cc',"
      echo "the comment character: git would drop or keep the line"
      echo "depending on how the message was given. Start the subject with"
      echo "a type, as in: type(scope): subject"
    } >&2
    exit 1
    ;;
esac
# The patterns are basic regular expressions, whose metacharacters are the ones
# escaped here: in a basic one `| + ? ( ) {` are literal, so any comment
# character is matched as itself. `--*` is one or more dashes.
ccre=$(printf '%s' "$cc" | sed -e 's/[][\\.*^$\/]/\\&/g')
clean="$work/message"
LC_ALL=C sed -e "/^$ccre --* >8 --*\$/,\$d" -e "/^$ccre/d" "$msgfile" >"$clean"

# 3. commitlint handed nothing prints its usage and exits as if it had crashed.
if ! LC_ALL=C grep -q '[^[:space:]]' "$clean"; then
  {
    echo "commit-msg: refused: the commit message is empty."
    echo "Write a message of the form: type(scope): subject"
  } >&2
  exit 1
fi

# 4. Find commitlint: PATH first, then npm's global prefix.
lint=$(command -v commitlint || true)
if [ -z "$lint" ] && command -v npm >/dev/null 2>&1; then
  prefix=$(npm prefix -g 2>/dev/null || true)
  if [ -n "$prefix" ] && [ -x "$prefix/bin/commitlint" ]; then
    lint="$prefix/bin/commitlint"
  fi
fi
if [ -z "$lint" ]; then
  {
    echo "commit-msg: refused: commitlint was not found, so this message"
    echo "has not been looked at."
    echo "Install it with: brew install commitlint"
    echo "If it is installed, the git client's PATH may lack Homebrew's bin"
    echo "folder (/opt/homebrew/bin)."
  } >&2
  exit 1
fi

# 5. Find the rules from this script's own path, so that a commit typed from a
#    subfolder or a linked worktree finds them.
rules="$(cd "$(dirname "$0")/.." && pwd)/commitlint.config.mjs"
if [ ! -f "$rules" ]; then
  {
    echo "commit-msg: refused: the rules file is missing: $rules"
    echo "Restore it with: git checkout HEAD -- commitlint.config.mjs"
  } >&2
  exit 1
fi

# 6. Run commitlint with --strict, for its exit codes. 7. Its own directory goes
#    first on PATH, since an npm install starts with `env node` and node sits
#    beside it.
out="$work/commitlint.out"
PATH="$(dirname "$lint"):$PATH" "$lint" --config "$rules" --strict --no-color \
  <"$clean" >"$out" 2>&1
status=$?

tooling_failure() {
  {
    cat "$out"
    echo
    echo "commit-msg: refused: commitlint could not check this message, so"
    echo "nothing has judged it. $1"
    echo "  commitlint: $lint ($(PATH="$(dirname "$lint"):$PATH" "$lint" --version 2>&1 | head -n 1))"
    echo "  node:       $(PATH="$(dirname "$lint"):$PATH" node --version 2>&1 | head -n 1)"
    echo "  rules:      $rules"
    echo "Rewording it will not help: fix the tool or the rules file."
  } >&2
  exit 1
}

case "$status" in
  0)
    exit 0
    ;;
  2)
    {
      cat "$out"
      echo
      echo "commit-msg: accepted: those are warnings, and a"
      echo "warning never refuses a commit."
    } >&2
    exit 0
    ;;
  3)
    if grep -q '\[empty-rules\]' "$out"; then
      tooling_failure "The rules file defines no rules."
    fi
    {
      cat "$out"
      echo
      echo "commit-msg: refused: the message does not follow the commit conventions."
      echo "Each ✖ line is a rule the message broke, and the commit is refused"
      echo "until it is fixed; each ⚠ line is a warning only. The rules are in"
      echo "commitlint.config.mjs at the repository root."
    } >&2
    exit 1
    ;;
  *)
    tooling_failure "commitlint exited with status $status."
    ;;
esac
