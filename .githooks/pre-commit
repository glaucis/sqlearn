#!/usr/bin/env bash
# Refuse a commit whose files fail `just pre-commit`.
# The checks run on an export of the index (what the commit will hold), not on
# the working tree, against this repository's own environment.
set -u

if ! command -v just >/dev/null 2>&1; then
  {
    echo "pre-commit: 'just' was not found on PATH."
    echo "Install the tools with: brew install just uv"
    echo "If they are installed, the git client's PATH may lack Homebrew's bin"
    echo "folder (/opt/homebrew/bin)."
  } >&2
  exit 1
fi

root=$(git rev-parse --show-toplevel) || exit 1

# core.hooksPath is shared by every checkout of the repository, and a checkout
# made after setup has no environment: refuse that plainly rather than let uv
# create an empty one and the first tool fail to start.
if [ ! -d "$root/.venv" ]; then
  {
    echo "pre-commit: this checkout has no environment ($root/.venv)."
    echo "Run 'just setup' in it, then commit again."
  } >&2
  exit 1
fi

work=$(mktemp -d) || exit 1
trap 'rm -rf "$work"' EXIT
tmp="$work/tree"

# git sets GIT_INDEX_FILE for a partial commit; checkout-index reads it.
if ! (cd "$root" && git checkout-index -a --prefix="$tmp/"); then
  echo "pre-commit: could not export the index." >&2
  exit 1
fi

# A passing commit prints nothing: keep the recipe's output until it fails.
out="$work/just.out"
if ! (cd "$tmp" && UV_PROJECT_ENVIRONMENT="$root/.venv" UV_NO_SYNC=1 just pre-commit) >"$out" 2>&1; then
  {
    cat "$out"
    echo
    echo "pre-commit: the commit is refused; the recipe named above failed."
    echo "Run that recipe alone with: just <recipe>"
    echo "Cures:"
    echo "  just fmt    fixes the formatting"
    echo "  uv lock     brings the lockfile up to date"
    echo "  uv sync     installs a tool the environment lacks"
    echo "The checks read the files going into this commit (the index), not"
    echo "the files on disk: stage your fix before committing again."
  } >&2
  exit 1
fi
exit 0
